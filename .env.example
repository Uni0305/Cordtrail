# Required: Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# ClickHouse connection settings (with docker compose, CLICKHOUSE_URL is fixed to http://clickhouse:8123)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=discord
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=discord
CLICKHOUSE_TIMEOUT_MS=30000

# Buffer/batch settings (optional)
BATCH_SIZE=1000
FLUSH_INTERVAL_MS=2000
BUFFER_CAPACITY=100000

# Log level (optional)
LOG_LEVEL=INFO

# Image tag used by docker-compose.prod.yml (optional, e.g. 1.2.3; default: latest)
# CORDTRAIL_TAG=latest
